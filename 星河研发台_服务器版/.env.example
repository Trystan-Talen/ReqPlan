# 改成服务器实际站点地址；生产环境只接受 HTTPS（加密连接）。
PUBLIC_ORIGIN=https://projects.example.com
# 默认只让本机已有的 HTTPS（加密连接）网关访问。
WEB_BIND=127.0.0.1
WEB_PORT=8080

# 首次服务器网页初始化时填写随机设置凭证；管理员创建后可清空。
# 本机双击启动器自动生成，无需手动设置。
XINGHE_SETUP_TOKEN=

# 自动备份：首次启动等待 60 秒，之后每 24 小时；失败后 30 分钟重试。
# 仅清理自动生成的备份，手动备份文件不会被删除。
BACKUP_ENABLED=1
BACKUP_INTERVAL_HOURS=24
BACKUP_RETAIN_COUNT=30
BACKUP_RETRY_MINUTES=30
BACKUP_INITIAL_DELAY_SECONDS=60
# 本机运行可指定目录；容器主备份固定保存在 /app/data/backups（数据卷备份目录）。
BACKUP_DIRECTORY=
# 可选第二目的目录；容器中须先通过卷挂载使该目录可写。
# 配置第二目录不代表完成异地备份。必须挂载另一受控设备，并核实物理位置与恢复能力。
# 同设备上的两个目录不能防止磁盘损坏；程序仅报告是否为不同设备。
BACKUP_SECONDARY_DIRECTORY=
# 服务器部署推荐：把第二份备份写到另一块磁盘上的宿主机目录（见 deploy/compose.offsite.yaml）。
# 取消下面两行注释并改成实际目录即可启用；目录须预先创建并 chown 1000:1000。
# BACKUP_SECONDARY_HOST_DIR=/mnt/backup-disk/xinghe
# COMPOSE_FILE=compose.yaml:deploy/compose.offsite.yaml
